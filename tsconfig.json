{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["remix.env.d.ts", "**/*.ts", "**/*.tsx", "app/components/Header.tsx"],
  "exclude": ["node_modules/*"],
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "watch": true,
    "sourceMap": true,
    "target": "ES2019",
    "module": "CommonJS",
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "rootDir": ".",
    "allowJs": true,
    "lib": ["DOM", "DOM.Iterable", "ES2019"],
    "jsx": "react-jsx",
    "paths": {
      "~/*": ["./app/*", "app-domain/cli/*", "app-domain/data-layer/*"]
    },
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  }
}
