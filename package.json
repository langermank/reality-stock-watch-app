    "eslint": "^8.11.0",
    "postcss": "^8.4.18",
    "postcss-cli": "^10.0.0",
    "postcss-import": "^15.0.0",
    "postcss-import-ext-glob": "^2.0.1",
    "postcss-mixins": "^9.0.4",
    "postcss-preset-env": "^7.8.2",
    "prettier": "2.6.2"
